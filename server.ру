import asyncio
import os
import websockets


async def process_request(connection, request):
    path = getattr(request, "path", "")
    headers = getattr(request, "headers", {})
    print(
        f"[REQ] path={path!r} upgrade={headers.get('Upgrade', '')!r} "
        f"conn={headers.get('Connection', '')!r} proto={headers.get('Sec-WebSocket-Protocol', '')!r}",
        flush=True,
    )
    return None


async def handler(websocket):
    remote = getattr(websocket, "remote_address", None)
    proto = getattr(websocket, "subprotocol", None)
    print(f"[CONNECTED] from={remote} proto={proto!r}", flush=True)

    try:
        async for message in websocket:
            print(f"[MSG] {message}", flush=True)
    except websockets.exceptions.ConnectionClosed as exc:
        print(f"[CLOSED] code={exc.code} reason={exc.reason!r}", flush=True)
    except Exception as exc:
        print(f"[ERROR] {type(exc).__name__}: {exc}", flush=True)


async def main():
    host = "0.0.0.0"
    port = int(os.environ.get("PORT", "10000"))
    print(f"[LISTEN] {host}:{port}", flush=True)

    async with websockets.serve(
        handler,
        host,
        port,
        process_request=process_request,
    ):
        await asyncio.Future()


if __name__ == "__main__":
    asyncio.run(main())
